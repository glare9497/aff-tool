# Mật khẩu đăng nhập dashboard
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên để ký cookie đăng nhập (vd: chạy `openssl rand -hex 32`)
AUTH_SECRET=

# Database: bỏ trống để dùng file SQLite local (data/aff.db).
# Khi deploy: dùng Turso (free) -> libsql://xxx.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Domain công khai cho short link, vd https://aff.tenban.com (bỏ trống = tự lấy theo host)
PUBLIC_BASE_URL=

# Shopee Affiliate Open API (không bắt buộc) - đăng ký tại affiliate.shopee.vn > Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Claude API cho tool viết kịch bản - tạo key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model dùng để viết kịch bản (mặc định claude-opus-5-5)
CLAUDE_MODEL=

# ===== Mạng xã hội (xem SOCIAL.md) =====
# Meta App: Facebook Page + Instagram
META_APP_ID=
META_APP_SECRET=
# TikTok Developer App
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Bí mật cho /api/cron khi deploy (chuỗi ngẫu nhiên)
CRON_SECRET=
# Cloudflare R2 lưu ảnh/video (bắt buộc cho Instagram và khi deploy)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
